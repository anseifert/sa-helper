# SA Task Hub — copy to .env and fill in required values.
# Used by docker compose (repo root) and local dev (export from repo root; see README).

# --- Required for Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match Google Cloud Console *exactly* (scheme, host, path — no trailing slash).
# Local dev:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
# Production (HTTPS — do not use http:// behind Caddy):
# GOOGLE_REDIRECT_URI=https://sa-hub.digitalgiants.net/api/v1/oauth/google/callback

# Space-separated OAuth scopes (defaults match Gmail/Calendar/Drive readonly).
# GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/drive.readonly

# --- Required for production ---
# Session/signing secret; use a long random string in production.
SECRET_KEY=change-me-in-production

# App login (protects UI and API). Required — you type these on the /login page.
APP_USERNAME=admin
APP_PASSWORD=choose-a-strong-password-here
# Optional; auto-enabled when FRONTEND_URL is https://
# AUTH_COOKIE_SECURE=true

# Fernet key for encrypting OAuth tokens in SQLite (base64 url-safe).
# Generate (from repo root, after backend venv + pip install -r requirements.txt):
#   backend/.venv/bin/python backend/scripts/generate_fernet_key.py
# Or: cd backend && source .venv/bin/activate && python scripts/generate_fernet_key.py
# Leave empty for ephemeral dev key (tokens won't survive restarts).
FERNET_KEY=

# Your SA email — used for internal vs external contact classification.
USER_EMAIL=

# --- App / database ---
# DEBUG=false
# DATABASE_URL=sqlite+aiosqlite:///./data/sa_task_hub.db

# --- URLs (CORS + OAuth redirect back to UI after Google login) ---
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://sa-hub.digitalgiants.net
# BACKEND_URL=http://localhost:8000

# --- Local Ollama (optional wording polish) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
# For local dev without Docker, use: OLLAMA_BASE_URL=http://localhost:11434

# --- Sync / task extraction ---
# SYNC_INTERVAL_MINUTES=60
# TASK_WINDOW_DAYS=30
# STALE_THREAD_DAYS=7

# --- Slack (stub; not required for MVP) ---
# SLACK_BOT_TOKEN=
