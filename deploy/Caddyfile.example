# Example Caddy config for SA Task Hub on a home server.
# Replace example.com and paths; enable HTTPS per your LAN/DNS setup.

example.com {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000 {
            transport http {
                read_timeout 10m
                write_timeout 10m
            }
        }
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

# Docker Compose: add a caddy service, mount this file, and put backend/frontend
# on an internal network. Example:
#
#   caddy:
#     image: caddy:2-alpine
#     ports:
#       - "443:443"
#       - "80:80"
#     volumes:
#       - ./deploy/Caddyfile:/etc/caddy/Caddyfile
#       - caddy-data:/data
#     depends_on:
#       - frontend
#       - backend
